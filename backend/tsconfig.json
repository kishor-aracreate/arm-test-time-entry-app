{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",       // good for ESM in Node
    "target": "esnext",         // latest JS features
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],          // enables Node.js globals like process, __dirname
    "esModuleInterop": true,    // allows default imports from CJS modules (like express)

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // (you can enable these if you want stricter lint-like checks)
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
