# -----------------------------------------------------------------------------
# 🌱 Environment Variables Example
# -----------------------------------------------------------------------------
# This file serves as a template for environment variables required to run
# the project. Copy it to a new file named `.env` and provide actual values
# specific to your environment.
#
# ✅ Purpose:
# - Prevent committing real secrets/credentials into version control.
# - Provide a reference for required configuration (devs & CI/CD).
# - Maintain consistency across different environments (local, staging, prod).
#
# 🚨 DO NOT commit your actual `.env` file.
# Each developer, staging system, and production system should maintain its
# own `.env` file with appropriate values.
# -----------------------------------------------------------------------------

# Example environment variables
# (Update these with real values when creating your `.env` file)

# Base API URL for backend services
REACT_APP_API_URL=https://api.example.com

# API key for Google Maps integration
REACT_APP_GOOGLE_MAPS_KEY=your-google-maps-api-key

# Feature flag to enable/disable experimental features
REACT_APP_FEATURE_FLAG=true

# -----------------------------------------------------------------------------
# 📝 Conventions:
# - Prefix variables with `REACT_APP_` so they are exposed to the client
#   (required by Create React App / Vite convention).
# - Use ALL_CAPS and snake_case for variable names.
# - Boolean flags should be lowercase `true` / `false`.
# -----------------------------------------------------------------------------

# Add additional environment variables as needed for your project
# e.g. REACT_APP_SENTRY_DSN=your-sentry-dsn
